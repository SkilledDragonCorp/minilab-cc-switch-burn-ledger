{
  "name": "@skilleddragon/minilab-cc-switch-burn-ledger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SkilledDragon minilab: port cc-switch session-usage accounting into a local burn ledger CLI",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.3",
  "bin": {
    "burn-ledger": "./bin/burn-ledger.ts"
  },
  "scripts": {
